# Copy these into Render → Environment (do not commit real secrets)

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/travira

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=another-long-random-string

# Gemini AI chat (required for chatbot)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-flash

# Public URL of this Render service
APP_BASE_URL=https://travira-app-minor.onrender.com

# Email / notifications + forgot-password mail (Gmail App Password)
# To change sender email: update EMAIL_USER, EMAIL_PASS, EMAIL_FROM on Render and redeploy.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-new-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=Travira <your-new-email@gmail.com>

# Optional seed superadmin
ROOT_ADMIN_EMAIL=admin@travira.app
ROOT_ADMIN_PASSWORD=change-me
ROOT_ADMIN_NAME=Admin

# Keep-alive (2–5 min). Set KEEP_ALIVE=false to disable
KEEP_ALIVE_MS=180000
# KEEP_ALIVE=false

# Dev only: always return reset token in forgot-password API
# EXPOSE_RESET_TOKEN=true
