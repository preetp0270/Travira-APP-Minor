# Copy this file to .env in the backend folder and fill in values.
# Do not commit .env

MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
APP_BASE_URL=https://travira-app-minor.onrender.com

# Brevo (recommended on Render free — HTTPS, no domain, any recipient)
# Create key: https://app.brevo.com/settings/keys/api
# EMAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_FROM=Travira <yourgmail@gmail.com>

# Do NOT set these on Render free (SMTP ports are blocked):
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# RESEND_API_KEY=
