# Copy these into Render → Environment (do not commit real secrets)

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/travira

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=another-long-random-string

# Gemini AI chat
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# Public URL
APP_BASE_URL=https://travira-app-minor.onrender.com

# ---- Email (Render FREE blocks SMTP ports 25/465/587) ----
# Use Resend HTTPS API (recommended):
RESEND_API_KEY=re_xxxxxxxx
# Free test sender (or your verified domain address):
EMAIL_FROM=Travira <onboarding@resend.dev>
# To send to any address, verify a domain at resend.com and use EMAIL_FROM=Travira <noreply@yourdomain.com>

# Optional SMTP — only works on paid Render plans:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=gmail-app-password
# EMAIL_FROM=Travira <you@gmail.com>

KEEP_ALIVE_MS=180000
